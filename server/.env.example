# Copy to .env and set GEMINI_API_KEY if you want real model calls.
#
# The one variable that matters: LLM_PROVIDER. It defaults to `fake`, which runs the entire
# pipeline against recorded fixtures with no network and no key, so a fresh checkout works
# immediately. Set it to `gemini` and supply a key to make real calls. See decision D13.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://distill:distill@localhost:5432/distill
# Generated SQL runs on this connection. The role holds SELECT and nothing else.
# See decision D10 and scripts/bootstrap_db.sql.
DATABASE_URL_READONLY=postgresql+asyncpg://distill_readonly:distill_readonly@localhost:5432/distill

STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=20

LLM_PROVIDER=fake
# GEMINI_API_KEY=
LLM_EXTRACT_MODEL=gemini-2.5-pro
LLM_QUERY_MODEL=gemini-2.5-flash
# Schema drift matching (decision D24). Field labels only, so this is cheap.
LLM_EMBED_MODEL=gemini-embedding-001
