# Copy to .env and set GEMINI_API_KEY if you want real model calls.
#
# The one variable that matters: LLM_PROVIDER. It defaults to `fake`, which runs the entire
# pipeline against recorded fixtures with no network and no key, so a fresh checkout works
# immediately. Set it to `gemini` and supply a key to make real calls. See decision D13.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://distill:distill@localhost:5432/distill
# There is no second, read-only connection any more. It existed to confine generated SQL
# (decision D10), and v2 generates none (decision D35), so the variable was removed rather
# than left here for an operator to set and wonder about.

STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=20

LLM_PROVIDER=fake
# GEMINI_API_KEY=

# Model identifiers, verified callable on September 5, 2026. See decision D62.
# The 2.5 identifiers this project originally named are no longer served to new API keys,
# and the Pro tier is not included in the free tier at all, so the strong tier is Flash and
# the tier a user waits on is Flash Lite, which starts an answer in under a second.
# Free-tier daily caps are per model and can be small: gemini-3.6-flash allows 20 requests
# a day. If a model reports `limit: 0` or runs out, point these at another Flash model.
LLM_EXTRACT_MODEL=gemini-3.5-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite
# Reasoning effort for the calls a user waits on: chat, dashboard, suggestions. `low` keeps
# a first token inside requirement FR-26's three seconds; the default setting took about
# twenty-five. Extraction ignores this and keeps the model's own default. Leave blank for a
# Gemini 2.x model, which has no thinking_level field.
LLM_FAST_THINKING_LEVEL=low

# Retrieval and schema drift matching (decisions D24, D36, D63).
LLM_EMBED_MODEL=gemini-embedding-001
# Requested vector width. 3072 is the model's native width and four times the storage for
# no gain at this corpus size. Changing this changes the vector space, so a workspace
# indexed at one width must be re-indexed after a change.
LLM_EMBED_DIMENSIONS=768
